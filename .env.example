# ─────────────────────────────────────────────────────────────────────────────
# Pnömotoraks AI — Ortam Değişkenleri
# Kullanım: cp .env.example .env  →  değerleri doldurun
# .env ASLA git'e commit edilmez.
# ─────────────────────────────────────────────────────────────────────────────

# ── Uygulama ──────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
ENVIRONMENT=production   # development | staging | production

# ── Model ─────────────────────────────────────────────────────────────────────
# Checkpoint klasörü (Docker volume mount noktasıyla eşleşmeli)
CHECKPOINT_DIR=/checkpoints
CHECKPOINT_HOST_PATH=./results/checkpoints  # docker-compose bind mount için

# Inference eşikleri (optimal_f1_threshold() sonucu buraya yazılır)
CLS_THRESHOLD=0.5
SEG_THRESHOLD=0.90

# ── Hugging Face Model Registry ───────────────────────────────────────────────
# Model versiyonlama için — opsiyonel ama önerilir
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx        # hf.co/settings/tokens (write)
HF_REPO_ID=your-org/pneumothorax-model  # örn: ahmet-ai/ptx-detector
HF_MODEL_VERSION=v1.0-ptx498-nih550     # semantik versiyon

# ── W&B Deney Takibi ──────────────────────────────────────────────────────────
# API key buraya YAZILMAZ — wandb login ile ~/.netrc'e kaydedilir
# veya CI/CD için:
# WANDB_API_KEY=...  (CI secret olarak saklanır)
WANDB_PROJECT=pneumothorax-tubitak
WANDB_ENTITY=ahmet-ai-t-bi-tak
WANDB_MODE=online   # online | offline | disabled

# ── Backend ───────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=8000
WORKERS=1           # GPU paylaşımı nedeniyle 1 (CPU için artırılabilir)

# CORS — üretimde kesinlikle "*" kullanmayın
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ── Veri ──────────────────────────────────────────────────────────────────────
MANIFEST_CSV=data/hospital_manifest.csv

# ── Güvenlik ──────────────────────────────────────────────────────────────────
# API anahtarı (gelecekte auth eklenirse)
# API_SECRET_KEY=generate-with-openssl-rand-hex-32
# JWT_SECRET_KEY=generate-with-openssl-rand-hex-32

# ── Monitoring (opsiyonel) ─────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx
