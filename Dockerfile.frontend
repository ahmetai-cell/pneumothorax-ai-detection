# ─────────────────────────────────────────────────────────────────────────────
# Frontend — React + Vite → nginx static serve
# Multi-stage: node build → nginx runtime (~25MB final image)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Node builder ────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /build

# package.json ve lock dosyasını önce kopyala (cache için)
COPY frontend/package.json frontend/package-lock.json* ./

RUN npm ci --prefer-offline

# Kaynak kodu kopyala ve build et
COPY frontend/ .

# VITE_API_URL build-time ortam değişkeni olarak enjekte edilebilir
# Production'da nginx proxy /api → backend olacak, bu değişken opsiyonel
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ── Stage 2: nginx runtime ───────────────────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Güvenlik: nginx varsayılan konfigürasyonunu temizle
RUN rm /etc/nginx/conf.d/default.conf

# nginx konfigürasyonu (docker-compose'dan mount edilecek)
# Fallback: gömülü basit konfigürasyon
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Build çıktısını nginx dizinine kopyala
COPY --from=builder /build/dist /usr/share/nginx/html

# Güvenlik başlıkları için nginx konfigürasyonu
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
